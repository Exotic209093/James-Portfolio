# Job dashboard access (private /jobs page, gated by middleware Basic Auth).
# Copy to .env.local for local development, and set the same values in the Vercel
# project's Environment Variables. If JOBS_DASHBOARD_PASSWORD is unset, /jobs is
# locked for everyone (fail closed).
JOBS_DASHBOARD_USER=james
JOBS_DASHBOARD_PASSWORD=change-me

# Optional free Google Analytics 4 web-stream ID (public, not a secret).
# Disable Enhanced Measurement in GA4; the site sends explicit events only.
# Set for Production and rebuild. Empty means no tag or consent controls load.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
